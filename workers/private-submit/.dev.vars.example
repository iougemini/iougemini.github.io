# 本地开发用变量（wrangler dev 会自动读取 .dev.vars）
# 复制为 .dev.vars 后填入真实值；该文件不要提交到仓库。

# 管理员登录密钥（≥16 位随机串）
ADMIN_KEY=replace-with-random-string

# GitHub Fine-grained PAT（Contents: Read and write，仅限本仓库）
GH_TOKEN=replace-with-fine-grained-pat

# Resend 留言发信（可选，不填则留言接口返回 503，前端走 mailto 兜底）
RESEND_API_KEY=re_replace_me

# Turnstile 服务端密钥（必填，否则投稿/留言的人机验证无法通过）
TURNSTILE_SECRET=0x4AAAAAAA_replace_me

# 非 Secret 变量
GITHUB_REPOSITORY=iougemini/iougemini.github.io
# 可选：Turnstile 站点密钥（不填则用 worker.js 内的默认值，与主站弹窗一致）
TURNSTILE_SITE_KEY=0x4AAAAAAF0gJ7CCSk4QFOeM
# 可选：本地开发时额外允许的 CORS 来源，逗号分隔（生产不要配置）
CORS_ORIGINS=http://localhost:8931,http://localhost:8932
